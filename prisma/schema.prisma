generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model PlantCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                       String               @id @default(cuid())
  name                     String
  scientificName           String?
  slug                     String               @unique
  description              String?
  price                    Float
  stock                    Int                  @default(0)
  categoryId               String
  flowerColor              String?
  flowerType               String?
  sunlightRequirement      SunlightRequirement?
  wateringFrequency        String?
  bloomSeason              String?
  fertilizerRecommendation String?
  potSize                  String?
  isFeatured               Boolean              @default(false)
  images                   String[]
  tags                     String[]
  seoTitle                 String?
  seoDescription           String?
  status                   ProductStatus        @default(DRAFT)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  serialNumber             Int?                 @unique
  category                 PlantCategory        @relation(fields: [categoryId], references: [id])
}

model Achievement {
  id          String    @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  date        DateTime?
  isFeatured  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Testimonial {
  id               String   @id @default(cuid())
  customerName     String
  story            String
  customerImageUrl String?
  plantImageUrl    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  imageUrl  String
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SunlightRequirement {
  FULL_SUN
  PARTIAL_SUN
  SHADE
}
